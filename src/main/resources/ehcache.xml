<config xmlns='http://www.ehcache.org/v3'>

    <persistence directory="ehcache.disk.store.dir/menu-cantine"/>

    <!-- Les réponses valides de la semaine courante et des semaines suivantes (réactualisées au bout de 6 heures) -->
    <cache alias="requetes">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="seconds">21600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <disk unit="MB" persistent="true">100</disk>
        </resources>
    </cache>

    <!-- Pour les menus des semaines passées, on les garde tant qu'il y a de la place -->
    <cache alias="permanent">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <disk unit="MB" persistent="true">100</disk>
        </resources>
    </cache>

    <!-- Pour les réponses en erreur, on les garde 30 min -->
    <cache alias="erreur">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="seconds">1800</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

    <!-- Cache sur les erreurs de demande de token, renouvelé toutes les 10 minutes -->
    <cache alias="token">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry>
            <ttl unit="seconds">600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
        </resources>
    </cache>

</config>